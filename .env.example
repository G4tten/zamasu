# Token del bot, da Discord Developer Portal > Bot
DISCORD_TOKEN=

# Application (Client) ID, da Discord Developer Portal > General Information
CLIENT_ID=

# Opzionale: ID della guild di test per registrare i comandi istantaneamente (guild-scoped).
# Lasciare vuoto per registrazione globale (produzione, propagazione fino a 1 ora).
GUILD_ID=
